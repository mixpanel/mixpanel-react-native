# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MixpanelExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Both C++ libs FMT and GLOG are pulled in by React Native. GLOG has a
    # dependency on FMT. However FMT has a language feature (consteval) that
    # requires C++20. React Native compiles FMT itself with C++20 but does
    # not do the same for GLOG, which compiles at C++17 and calls into FMT.
    # A newly shipped XCode version now moves that compiler version mismatch
    # from a warn to a hard error causing CI failure. Forcing GLOG to C++20
    # via CLANG_CXX_LANGUAGE_STANDARD doesn't take effect reliably (xcconfig
    # precedence), so instead we tell FMT to skip the consteval codepath via
    # its own opt-out macro. GLOG then compiles cleanly at C++17.
    #
    # Community reference (same workaround, same root cause):
    #   https://github.com/expo/expo/pull/44919
    # Upstream fix (RN 0.83.9+ bundles fmt 12.1.0 which no longer needs this):
    #   https://github.com/facebook/react-native/pull/56099
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -DFMT_USE_CONSTEVAL=0'
        end
      end
    end
  end
end
